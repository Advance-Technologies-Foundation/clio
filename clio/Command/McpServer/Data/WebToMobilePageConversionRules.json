{
  "version": "latest",
  "templates": [
    {
      "web": "ListPageV3Template",
      "mobile": "BaseMobileListTemplate",
      "note": "Section / list page.",
      "containers": [
        { "web": "MainContainer", "mobile": "MainContainer" },
        { "web": "LeftFilterContainer", "mobile": "HeaderContainer" },
        { "web": "RightFilterContainer", "mobile": "HeaderContainer" },
        { "web": "ListContainer", "mobile": "ListContainer" }
      ],
      "components": [
        { "web": "DataTable", "mobile": "List" },
        {
          "web": "FolderTree",
          "mobile": "FolderTreeActions",
          "mobileType": "crt.FolderTreeActions",
          "carryProperties": ["sourceSchemaName", "rootSchemaName"],
          "note": "Folder tree. The mobile template (BaseMobileListTemplate) already provides the FolderTreeActions element; carry the web folder-schema binding (sourceSchemaName + rootSchemaName) onto it by merge-by-name so the mobile folder tree resolves the section entity. Without this the web crt.FolderTree node (inherited template chrome) is pruned and rootSchemaName is lost."
        }
      ]
    },
    {
      "web": "PageWithTabsFreedomTemplate",
      "mobile": "MobilePageWithTabsFreedomTemplate",
      "note": "Tabbed record page (Tabs + Feed + Attachments). Preferred target for web tabbed record pages.",
      "containers": [
        { "web": "Tabs", "mobile": "Tabs" },
        { "web": "GeneralInfoTab", "mobile": "GeneralInfoTab", "childrenTo": "GeneralTabContainer" },
        { "web": "GeneralInfoTabContainer", "mobile": "GeneralTabContainer" },
        { "web": "FeedTabContainer", "mobile": "FeedContainer" },
        { "web": "AttachmentsTabContainer", "mobile": "AttachmentsContainer" },
        { "web": "CardToggleTabPanel", "mobile": "Tabs" },
        { "web": "CardContentWrapper", "mobile": "GeneralTabContainer" },
        { "web": "SideAreaProfileContainer", "mobile": "AreaProfileContainer" },
        { "web": "CardContentWrapper:top", "mobile": "Tabs:top" },
        { "web": "CardContentWrapper:bottom", "mobile": "Tabs:bottom" }
      ],
      "components": [
        { "web": "AttachmentList", "mobile": "AttachmentFileList" }
      ]
    },
    {
      "web": "BasePageFreedomTemplate",
      "mobile": "BaseMobilePageTemplate",
      "note": "Base record page (non-tabbed). Web BasePageFreedomTemplate maps to the mobile base record page.",
      "containers": [
        { "web": "MainContainer", "mobile": "MainContainer" },
        { "web": "CardContentWrapper", "mobile": "MainContainer" }
      ]
    },
    {
      "web": "BlankPageTemplate",
      "mobile": "BlankMobilePageTemplate",
      "note": "Blank page. Mobile blank exposes only the Scaffold root.",
      "containers": [
        { "web": "MainContainer", "mobile": "MainContainer" }
      ]
    },
    {
      "web": "BasePageTemplate",
      "mobile": "BaseMobilePageTemplate",
      "note": "Base page template; maps to the mobile base record page. Universal fallback container is MainContainer.",
      "containers": [
        { "web": "MainContainer", "mobile": "MainContainer" }
      ]
    },
    {
      "web": "BaseTemplate",
      "mobile": "BaseMobileTemplate",
      "note": "Base web template root; maps to the mobile structural root. Universal fallback container is MainContainer.",
      "containers": [
        { "web": "MainContainer", "mobile": "MainContainer" }
      ]
    }
  ],
  "components": [
    {
      "filters": [{ "type": "crt.DataGrid" }, { "type": "crt.DataTable" }],
      "viewConfigTemplates": [
        {
          "preserveSourceProperties": true,
          "parentName": "{{ diff.parentName }}",
          "propertyName": "{{ diff.propertyName }}",
          "value": {
            "type": "crt.List",
            "name": "{{ diff.name }}",
            "items": "{{ source.items }}",
            "itemLayout": {
              "name": "{{ diff.name }}_ListItem",
              "type": "crt.ListItem",
              "title": "${{ source.columns[0].code }}",
              "body": { "$each": "source.columns[1:]", "as": { "value": "${{ code }}" } }
            }
          }
        }
      ]
    },
    {
      "filters": [{ "type": "crt.Checkbox" }],
      "viewConfigTemplates": [
        {
          "preserveSourceProperties": true,
          "value": { "type": "crt.Toggle" }
        }
      ]
    },
    {
      "filters": [{ "type": "crt.HtmlEditor" }],
      "viewConfigTemplates": [
        {
          "preserveSourceProperties": true,
          "value": { "type": "crt.RichTextEditor" }
        }
      ]
    },
    {
      "path": ["MainHeader"],
      "filters": [{ "type": "crt.Button" }, { "type": "crt.MenuItem" }],
      "viewConfigTemplates": [
        {
          "parentName": "FloatingActionButton",
          "propertyName": "menuItems",
          "value": {
            "type": "crt.MenuItem",
            "name": "{{ diff.name }}",
            "caption": "{{ source.caption }}",
            "visible": "{{ source.visible }}",
            "clicked": "{{ source.clicked }}"
          }
        }
      ]
    }
  ],
  "tabAreaLayers": {
    "tabComponentType": "crt.TabContainer",
    "mainTabContainer": {
      "namePrefix": "MainTabContainer_",
      "values": {
        "type": "crt.GridContainer",
        "gap": { "rowGap": "medium", "columnGap": "medium" },
        "alignItems": "stretch",
        "padding": { "bottom": "medium" }
      },
      "areaContainer": {
        "namePrefix": "GridContainer_",
        "values": {
          "type": "crt.GridContainer",
          "padding": { "top": "medium", "bottom": "medium", "right": "medium", "left": "medium" },
          "color": "primary",
          "borderRadius": "medium",
          "gap": { "rowGap": "medium", "columnGap": "medium" },
          "alignItems": "stretch"
        }
      }
    }
  },
  "componentPropertyOverrides": [
    {
      "filters": [{ "type": "crt.GridContainer" }],
      "values": { "gap": { "rowGap": "medium", "columnGap": "medium" } }
    },
    {
      "filters": [{ "type": "crt.GridContainer", "values": { "borderRadius": "medium" } }, { "type": "crt.FlexContainer", "values": { "borderRadius": "medium" } }],
      "values": { "borderRadius": "large" }
    },
    {
      "filters": [{ "type": "crt.FlexContainer" }],
      "values": { "gap": "medium" }
    },
    {
      "filters": [{ "type": "crt.IndicatorWidget" }],
      "mergeNestedObjects": true,
      "values": {
        "config": {
          "text": { "fontSizeMode": "extra-small" },
          "layout": { "border": { "hidden": true } }
        }
      }
    }
  ],
  "contentContainerTypes": [ "crt.FlexContainer", "crt.GridContainer", "crt.TabContainer", "crt.ExpansionPanel" ],
  "emptyContainerRemoval": {
    "removableTypes": [
      "crt.FlexContainer",
      "crt.GridContainer",
      "crt.TabPanel",
      "crt.TabContainer",
      "crt.ExpansionPanel"
    ]
  },
  "excludedComponents": [
    {
      "filters": [
        {
          "type": "crt.SearchFilter",
          "parentType": "crt.ExpansionPanel",
          "propertiesContainerName": "tools",
          "note": "ENG-95081: the panel's tools strip is a compact icon-only header row on mobile, which a search field does not fit. Positional only - crt.SearchFilter elsewhere on the page converts normally."
        }
      ]
    }
  ],
  "nonConvertingScopeContainers": ["MainHeader"],
  "requests": [
    { "web": "crt.SaveRecordRequest", "mobile": "crt.SaveRecordRequest", "category": "DirectMapping" },
    { "web": "crt.CreateRecordRequest", "mobile": "crt.CreateRecordRequest", "category": "DirectMapping" },
    { "web": "crt.UpdateRecordRequest", "mobile": "crt.UpdateRecordRequest", "category": "DirectMapping" },
    { "web": "crt.DeleteRecordRequest", "mobile": "crt.DeleteRecordRequest", "category": "DirectMapping" },
    { "web": "crt.CopyRecordRequest", "mobile": "crt.CopyRecordRequest", "category": "DirectMapping" },
    { "web": "crt.CancelRecordChangesRequest", "mobile": "crt.CancelRecordChangesRequest", "category": "DirectMapping" },
    { "web": "crt.ClosePageRequest", "mobile": "crt.ClosePageRequest", "category": "DirectMapping" },
    { "web": "crt.OpenPageRequest", "mobile": "crt.OpenPageRequest", "category": "DirectMapping" },
    { "web": "crt.OpenLookupPageRequest", "mobile": "crt.OpenLookupPageRequest", "category": "DirectMapping" },
    { "web": "crt.OpenCustomWebViewPageRequest", "mobile": "crt.OpenCustomWebViewPageRequest", "category": "DirectMapping" },
    { "web": "crt.ShowDialogRequest", "mobile": "crt.ShowDialogRequest", "category": "DirectMapping" },
    { "web": "crt.OpenAddressOnMapRequest", "mobile": "crt.OpenAddressOnMapRequest", "category": "DirectMapping" },
    { "web": "crt.LoadDataRequest", "mobile": "crt.LoadDataRequest", "category": "DirectMapping" },
    { "web": "crt.QuickFilterRequest", "mobile": "crt.QuickFilterRequest", "category": "DirectMapping" },
    { "web": "crt.ExecuteExpressionRequest", "mobile": "crt.ExecuteExpressionRequest", "category": "DirectMapping" },
    { "web": "crt.RunBusinessProcessRequest", "mobile": "crt.RunBusinessProcessRequest", "category": "DirectMapping" },
    { "web": "crt.CreateListItemRequest", "mobile": "crt.CreateListItemRequest", "category": "DirectMapping" },
    { "web": "crt.UpdateListItemRequest", "mobile": "crt.UpdateListItemRequest", "category": "DirectMapping" },
    { "web": "crt.DeleteListItemRequest", "mobile": "crt.DeleteListItemRequest", "category": "DirectMapping" },
    { "web": "crt.UploadFileRequest", "mobile": "crt.UploadFileRequest", "category": "DirectMapping" },
    { "web": "crt.DeleteFileRequest", "mobile": "crt.DeleteFileRequest", "category": "DirectMapping" },
    { "web": "crt.AddCommunicationOptionsRequest", "mobile": "crt.AddCommunicationOptionsRequest", "category": "DirectMapping" },
    { "web": "crt.CreateCommunicationOptionRequest", "mobile": "crt.CreateCommunicationOptionRequest", "category": "DirectMapping" },
    { "web": "crt.RemoveCommunicationOptionRequest", "mobile": "crt.RemoveCommunicationOptionRequest", "category": "DirectMapping" },
    { "web": "crt.SetAttributeFromBarcodeRequest", "mobile": "crt.SetAttributeFromBarcodeRequest", "category": "DirectMapping" }
  ]
}
