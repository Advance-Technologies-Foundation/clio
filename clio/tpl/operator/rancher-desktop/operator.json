    {
      "apiVersion": "rbac.authorization.k8s.io/v1",
      "kind": "ClusterRoleBinding",
      "metadata": {
        "name": "creatio-operator",
        "annotations": {
          "clio.creatio.com/install-profile": "rancher-desktop-v1"
        }
      },
      "roleRef": {
        "apiGroup": "rbac.authorization.k8s.io",
        "kind": "ClusterRole",
        "name": "creatio-operator"
