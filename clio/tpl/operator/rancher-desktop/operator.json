      "spec": {
        "ingressClassName": "traefik",
        "rules": [
          {
            "host": "creatio-operator.localhost",
            "http": {
              "paths": [
                {
                  "path": "/",
                  "pathType": "Prefix",
                  "backend": {
                    "service": {
                      "name": "creatio-operator",
                      "port": {
                        "number": 8080
                      }
                    }
                  }
                }
              ]
            }
          }
        ]
      }
