# @angular-architects/module-federation@^14.2.3 declares a peer dependency on
# @angular/common/@angular/core >=14.1.1, while this template pins Angular ~13.3.0.
# Without this flag, a plain `npm install`/`npm ci` fails with ERESOLVE against the
# committed package-lock.json. This is a pre-existing version mismatch in the
# template's own package.json, not something to silently "fix" by bumping Angular
# here — track upgrading this template to a mutually compatible Angular/
# module-federation pair separately.
legacy-peer-deps=true
