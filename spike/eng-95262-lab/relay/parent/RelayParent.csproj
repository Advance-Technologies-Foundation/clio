<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>RelayParent</AssemblyName>
    <NoWarn>$(NoWarn);CS1591;CS8632</NoWarn>
    <!-- Throwaway spike: opt out of the repository's central package management and analyzers so this
         project builds standalone and can never affect a repo-wide build. -->
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    <RunAnalyzers>false</RunAnalyzers>
    <EnableNETAnalyzers>false</EnableNETAnalyzers>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="ModelContextProtocol" Version="1.4.1" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="9.0.0" />
  </ItemGroup>
</Project>
