#!/usr/bin/env bash
# Stand-in for the gh CLI used by scripts/tests/claim-issue.tests.sh.
#
# State lives in $FAKE_GH_STATE (one line per assignee, one record per comment) so a test can
# assert on what the claim protocol actually did. Failure knobs let a test reproduce the
# fail-open conditions found in review:
#   FAKE_GH_FAIL_USER    `gh api user` exits non-zero
#   FAKE_GH_FAIL_VIEW    `gh issue view` exits non-zero
#   FAKE_GH_FAIL_ASSIGN  `gh issue edit --add-assignee` exits non-zero
#   FAKE_GH_DENY_ASSIGN  assignment exits 0 but silently does not take effect
#   FAKE_GH_FAIL_COMMENT `gh issue comment` exits non-zero
#   FAKE_GH_BARRIER      directory used to release N callers of `gh api user` together
#   FAKE_GH_NWO          what `gh repo view --json nameWithOwner` reports (default acme/widgets)
set -uo pipefail

state="${FAKE_GH_STATE:?FAKE_GH_STATE must be set}"
mkdir -p "$state"
assignees_file="$state/assignees"
comments_file="$state/comments"
touch "$assignees_file" "$comments_file"

log_call() { printf '%s\n' "$*" >>"$state/calls"; }
log_call "$@"

barrier_wait() {
    [[ -n "${FAKE_GH_BARRIER:-}" ]] || return 0
    local want="${FAKE_GH_BARRIER_COUNT:-2}" waited=0
    mkdir -p "$FAKE_GH_BARRIER"
    : >"$FAKE_GH_BARRIER/$$"
    while (( $(find "$FAKE_GH_BARRIER" -type f | wc -l) < want )); do
        sleep 0.05
        waited=$((waited + 1))
        (( waited > 200 )) && break   # 10s cap so a broken test fails instead of hanging
    done
}

case "${1:-}" in
    api)
        if [[ "${2:-}" == user ]]; then
            [[ -n "${FAKE_GH_FAIL_USER:-}" ]] && { echo 'fake gh: api user failed' >&2; exit 1; }
            barrier_wait
            printf '%s\n' "${FAKE_GH_LOGIN:-agent-shared}"
            exit 0
        fi
        echo "fake gh: unsupported api call: $*" >&2; exit 64
        ;;
    repo)
        if [[ "${2:-}" == view ]]; then
            # Which field is asked for decides the answer; --repo is accepted and ignored.
            field=''
            while (( $# )); do
                [[ "$1" == --json ]] && field="${2:-}"
                shift
            done
            case "$field" in
                nameWithOwner)    printf '%s\n' "${FAKE_GH_NWO:-acme/widgets}" ;;
                defaultBranchRef) printf '%s\n' "${FAKE_GH_DEFAULT_BRANCH:-master}" ;;
                *) echo "fake gh: unsupported repo --json field: $field" >&2; exit 64 ;;
            esac
            exit 0
        fi
        echo "fake gh: unsupported repo call: $*" >&2; exit 64
        ;;
    issue)
        sub="${2:-}"; shift 2 || true
        issue="${1:-}"; shift || true
        case "$sub" in
            view)
                [[ -n "${FAKE_GH_FAIL_VIEW:-}" ]] && { echo 'fake gh: issue view failed' >&2; exit 1; }
                # The caller always passes `--json <field> -q <expr>`; only the field matters here.
                field=''
                while (( $# )); do
                    [[ "$1" == --json ]] && field="${2:-}"
                    shift
                done
                case "$field" in
                    assignees) grep -v '^$' "$assignees_file" || true ;;
                    comments)  sed 's/\\n/\
/g' "$comments_file" || true ;;
                    *) echo "fake gh: unsupported --json field: $field" >&2; exit 64 ;;
                esac
                exit 0
                ;;
            edit)
                [[ -n "${FAKE_GH_FAIL_ASSIGN:-}" ]] && { echo 'fake gh: issue edit failed' >&2; exit 1; }
                if [[ -n "${FAKE_GH_DENY_ASSIGN:-}" ]]; then
                    # The shape the review reproduced: gh reports success, the assignee is not set.
                    echo "fake gh: assignment silently denied on issue #$issue"
                    exit 0
                fi
                who=''
                while (( $# )); do
                    [[ "$1" == --add-assignee ]] && who="${2:-}"
                    shift
                done
                if [[ -n "$who" ]] && ! grep -qx "$who" "$assignees_file" 2>/dev/null; then
                    printf '%s\n' "$who" >>"$assignees_file"
                fi
                echo "fake gh: assigned #$issue to $who"
                exit 0
                ;;
            comment)
                [[ -n "${FAKE_GH_FAIL_COMMENT:-}" ]] && { echo 'fake gh: issue comment failed' >&2; exit 1; }
                body=''
                while (( $# )); do
                    [[ "$1" == --body ]] && body="${2:-}"
                    shift
                done
                # Flattened to one line per comment so concurrent appends cannot interleave.
                printf '%s\n' "${body//$'\n'/\\n}" >>"$comments_file"
                echo "fake gh: commented on #$issue"
                exit 0
                ;;
            *) echo "fake gh: unsupported issue subcommand: $sub" >&2; exit 64 ;;
        esac
        ;;
    *) echo "fake gh: unsupported command: $*" >&2; exit 64 ;;
esac
