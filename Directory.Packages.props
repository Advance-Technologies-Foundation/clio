<!-- 
This file is used to centralize the management of package versions across multiple projects in the solution. 
By defining package versions here, we can ensure consistency and simplify updates. 
Each project can reference these packages without specifying the version, as they will inherit the version defined 
in this central file.

See docs: https://devblogs.microsoft.com/dotnet/introducing-central-package-management/ 
-->
<Project>
  <PropertyGroup>
    <!-- Treat NU1903 (vulnerable package) as error to prevent accidental usage of vulnerable versions. -->
    <WarningsAsErrors>$(WarningsAsErrors);NU1903</WarningsAsErrors>
    
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- Transitive pinning: every PackageVersion below also governs the transitive graph, so a
         vulnerable transitive version cannot silently win restore if the dependency graph shifts. -->
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
    <!-- cliogate / cliogate.tests are the legacy net472 / netstandard2.0 island (VersionOverride pins such as
         Npgsql 8.0.3); the clio-wide pins (Npgsql 10.x, ...) are not compatible with those frameworks. -->
    <CentralPackageTransitivePinningEnabled Condition="$(MSBuildProjectName.StartsWith('cliogate'))">false</CentralPackageTransitivePinningEnabled>
    
    <MsPackageVersion>10.0.13</MsPackageVersion>
    <SIOVersion>22.2.0</SIOVersion>
    <AvaloniaVersion>12.1.1</AvaloniaVersion>
    <IdentityModelVersion>8.22.0</IdentityModelVersion>
    <ModelContextProtocolVersion>2.2.0</ModelContextProtocolVersion>
    
  </PropertyGroup>
  <ItemGroup Label="Used in production">
    <PackageVersion Include="Avalonia" Version="$(AvaloniaVersion)" />
    <PackageVersion Include="Avalonia.Desktop" Version="$(AvaloniaVersion)" />
    <PackageVersion Include="Avalonia.Fonts.Inter" Version="$(AvaloniaVersion)" />
    <PackageVersion Include="Avalonia.Headless" Version="$(AvaloniaVersion)" />
    <PackageVersion Include="Avalonia.Skia" Version="$(AvaloniaVersion)" />
    <PackageVersion Include="Avalonia.Themes.Fluent" Version="$(AvaloniaVersion)" />
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <!-- ENG-93885: ToolContractGetTool.IsLegacyStdioClient relies on this SDK capturing Server.ClientInfo
         at initialize-REQUEST time (no notifications/initialized required). Keep
         ToolContractGetToolLegacyClientRawStdioE2ETests as the upgrade gate for the unpatchable CAADT
         1.4.0 stdio client. -->
    <PackageVersion Include="ModelContextProtocol" Version="$(ModelContextProtocolVersion)" />
    <PackageVersion Include="ModelContextProtocol.AspNetCore" Version="$(ModelContextProtocolVersion)" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="$(MsPackageVersion)" />
    <PackageVersion Include="Microsoft.Extensions.Http" Version="$(MsPackageVersion)" />
    <PackageVersion Include="Microsoft.Extensions.Configuration" Version="$(MsPackageVersion)" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Binder" Version="$(MsPackageVersion)" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="$(MsPackageVersion)" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.FileExtensions" Version="$(MsPackageVersion)" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Json" Version="$(MsPackageVersion)" />
    <PackageVersion Include="Microsoft.AspNetCore.SignalR.Client" Version="$(MsPackageVersion)" />
    <!-- JwtBearer ships per ASP.NET Core major (10.0.x is net10-only); pin per TFM so the
         net8.0 target restores a net8-compatible build (ENG-93386).
         NOTE (runtime hygiene): clio references ASP.NET Core via <FrameworkReference Include="Microsoft.AspNetCore.App" />,
         so the Kestrel/JwtBearer assemblies actually LOADED come from the installed shared runtime, not this pin —
         this version is effectively a build-time floor, not the operative security control. The mcp-http OAuth edge
         exposes a public Kestrel endpoint, and CVE-2025-55315 (request-smuggling / security-feature-bypass, CVSS 9.9)
         affects ASP.NET Core 8 runtimes <= 8.0.20. The real control is deploying on a PATCHED runtime:
         .NET 8 >= 8.0.21 or .NET 10 >= 10.0.10 (minimum patched versions). See docs/commands/mcp-http.md (Deployment / runtime). -->
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="$(MsPackageVersion)"
                    Condition="'$(TargetFramework)' == 'net10.0'" />
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.11"
                    Condition="'$(TargetFramework)' != 'net10.0'" />
    <!-- Test-only in-memory ASP.NET Core pipeline (ENG-93386); same per-TFM split as JwtBearer above. -->
    <PackageVersion Include="Microsoft.AspNetCore.TestHost" Version="$(MsPackageVersion)"
                    Condition="'$(TargetFramework)' == 'net10.0'" />
    <PackageVersion Include="Microsoft.AspNetCore.TestHost" Version="8.0.11"
                    Condition="'$(TargetFramework)' != 'net10.0'" />
    <!-- CVE-2026-50648 (GHSA-23rf-6693-g89p, DoS via crafted encrypted XML) affects <= 10.0.9 and fires
         NU1903 Warning-As-Error at restore; $(MsPackageVersion) is patched. System.Security.Cryptography.Xml,
         .Pkcs and SignalR.Common are only reached transitively (PowerShell.SDK / SignalR.Client); they are
         lifted by CentralPackageTransitivePinningEnabled, so no per-csproj reference is needed. -->
    <PackageVersion Include="System.Security.Cryptography.Xml" Version="$(MsPackageVersion)" />
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="$(MsPackageVersion)" />
    <PackageVersion Include="Microsoft.AspNetCore.SignalR.Common" Version="$(MsPackageVersion)" />
    <!-- Kept on the resolver's proven netstandard2.0 compatibility line. -->
    <PackageVersion Include="System.Text.Json" Version="8.0.5" Condition="$(MSBuildProjectName.StartsWith('Creatio.ConflictResolver'))" />
    <!-- With transitive pinning on, a fixed 8.0.5 would downgrade the 10.0.x System.Text.Json that
         JsonhCs / Microsoft.Extensions.Configuration.Json require (NU1109) in the net8.0/net10.0 apps. -->
    <PackageVersion Include="System.Text.Json" Version="$(MsPackageVersion)" Condition="!$(MSBuildProjectName.StartsWith('Creatio.ConflictResolver'))" />
    <PackageVersion Include="System.IO.Abstractions" Version="$(SIOVersion)" />
    <!-- Scoped to the Roslyn analyzer projects: with transitive pinning enabled an unconditional pin would also
         force Roslyn 5.6 into the PowerShell.SDK graph (Add-Type) of clio / clio.tests / clio.mcp.e2e. -->
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="5.6.0" Condition="$(MSBuildProjectName.StartsWith('Clio.Analyzers'))" />
    <!-- IdentityModel requires every library in its recursive runtime family to use the same version. -->
    <PackageVersion Include="Microsoft.IdentityModel.Abstractions" Version="$(IdentityModelVersion)" />
    <PackageVersion Include="Microsoft.IdentityModel.JsonWebTokens" Version="$(IdentityModelVersion)" />
    <PackageVersion Include="Microsoft.IdentityModel.Logging" Version="$(IdentityModelVersion)" />
    <PackageVersion Include="Microsoft.IdentityModel.Protocols" Version="$(IdentityModelVersion)" />
    <PackageVersion Include="Microsoft.IdentityModel.Protocols.OpenIdConnect" Version="$(IdentityModelVersion)" />
    <PackageVersion Include="Microsoft.IdentityModel.Tokens" Version="$(IdentityModelVersion)" />
    <PackageVersion Include="System.IdentityModel.Tokens.Jwt" Version="$(IdentityModelVersion)" />
    <PackageVersion Include="Microsoft.Data.SqlClient" Version="7.0.2" />
    <PackageVersion Include="creatio.client" Version="2.1.0" />
    <PackageVersion Include="CommandLineSDK" Version="1.0.11" />
    <PackageVersion Include="ATF.Repository" Version="2.0.3.5" />
    <PackageVersion Include="ErrorOr" Version="2.1.1" />
    <PackageVersion Include="Npgsql" Version="10.0.3" />
    <PackageVersion Include="NRedisStack" Version="1.7.3" />
    <PackageVersion Include="Spectre.Console" Version="0.57.2" />
    <PackageVersion Include="ConsoleTables" Version="2.7.0" />
    <PackageVersion Include="FluentValidation" Version="12.1.1" />
    <PackageVersion Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageVersion Include="OneOf" Version="3.0.271" />
    <PackageVersion Include="Ignore" Version="0.2.1" />
    <PackageVersion Include="YamlDotNet" Version="18.1.0" />
    <PackageVersion Include="SharpZipLib" Version="1.4.2" />
    <PackageVersion Include="JsonhCs" Version="7.8.0" />
    <PackageVersion Include="KubernetesClient" Version="19.0.2" />
    <PackageVersion Include="System.IO.Compression" Version="4.3.0" />
    <!-- net8.0 stays on the 7.4 LTS line (clio.csproj VersionOverride [7.4.13,7.5.0)). With transitive pinning
         a single 7.6.3 pin falls outside that range and silently drops PowerShell.SDK from the net8.0
         graph of every project that references clio (clio.mcp.e2e), so pin per TFM. -->
    <PackageVersion Include="Microsoft.PowerShell.SDK" Version="7.6.3" Condition="'$(TargetFramework)' != 'net8.0'" />
    <PackageVersion Include="Microsoft.PowerShell.SDK" Version="7.4.13" Condition="'$(TargetFramework)' == 'net8.0'" />
    <PackageVersion Include="Microsoft.Dism" Version="6.1.0" />
    <PackageVersion Include="DocumentFormat.OpenXmlSDK" Version="2.0.0"/>
    <PackageVersion Include="Microsoft.Web.Administration" Version="11.1.0"/>
    <PackageVersion Include="Acornima" Version="1.7.0" />
    <PackageVersion Include="Tomlyn" Version="2.10.1" />
  </ItemGroup>
  <ItemGroup Label="Used in tests">
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
    <PackageVersion Include="System.IO.Abstractions.TestingHelpers" Version="$(SIOVersion)" />
    <PackageVersion Include="FluentAssertions" Version="7.2.2" />
    <!-- Scoped to ClioRing.Tests: unconditionally pinned, it would also lift JsonSchema.Net 7 -> 9 inside
         Microsoft.PowerShell.Commands.Utility (Test-Json) in the clio graph once transitive pinning is on. -->
    <PackageVersion Include="JsonSchema.Net" Version="9.2.2" Condition="'$(MSBuildProjectName)' == 'ClioRing.Tests'" />
    <PackageVersion Include="nunit" Version="4.6.1" />
    <PackageVersion Include="NUnit3TestAdapter" Version="6.2.0" />
    <PackageVersion Include="ATF.Repository.Mock" Version="2.0.3.1" />
    <PackageVersion Include="coverlet.collector" Version="10.0.1" />
    <PackageVersion Include="NSubstitute" Version="6.0.0" />
    <PackageVersion Include="NUnit.Analyzers" Version="4.14.0" />
    <PackageVersion Include="Allure.NUnit" Version="2.15.0" />
  </ItemGroup>
</Project>
